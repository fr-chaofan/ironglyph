; 全域畫面環境。
;
; ⚠️ **宣紙底之後 glow 關閉。** 發光是為了讓亮色在深背景上跳出來；
;    在紙上它只會把整個畫面糊成一片霧，而且 bloom 會把筆畫之間的分隔抹平——
;    「字看著糊」的元凶之一就是它。節點保留著，日後若有需要局部發光的演出
;    （終章「主」降臨的純白光）再打開。
;
; ⚠️ 每個關卡場景各自 instance 一份。WorldEnvironment 必須在場景樹裡才有作用，
;    不能做成 autoload 的純腳本單例。

[gd_scene load_steps=2 format=3]

[sub_resource type="Environment" id="Environment_glow"]
background_mode = 3
glow_enabled = false
glow_normalized = true
glow_intensity = 0.6
glow_strength = 1.0
glow_bloom = 0.05
glow_blend_mode = 1
glow_hdr_threshold = 1.0
glow_hdr_scale = 2.0

[node name="WorldEnvironment" type="WorldEnvironment"]
environment = SubResource("Environment_glow")
