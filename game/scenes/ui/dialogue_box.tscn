; 對話框 UI（Task 4.0）。序章教程、Boss開場白、賜俸三選一、終章訓誡共用這一個場景。
;
; ⚠️ 根節點是 CanvasLayer：對話框是螢幕座標的 UI，不可以掛成關卡 Node2D 的子節點，
;    否則會跟著鏡頭捲動。layer 設得比 HUD 高，對話期間必須蓋在血條/提示上面。
;
; 節點路徑（Panel/Label、Panel/SpeakerLabel、Panel/ChoiceContainer、Panel/AdvancePrompt）
; 是 dialogue_box.gd 的 @onready 依賴，改名前先改腳本。

[gd_scene load_steps=4 format=3]

[ext_resource type="Script" uid="uid://bkv1ieav1xgnv" path="res://scripts/dialogue_box.gd" id="1_dialogue"]
[ext_resource type="FontFile" uid="uid://147hwlqef2e7" path="res://assets/fonts/LXGWWenKaiTC-Regular.ttf" id="2_font"]

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_panel"]
content_margin_left = 24.0
content_margin_top = 16.0
content_margin_right = 24.0
content_margin_bottom = 16.0
bg_color = Color(0.06, 0.06, 0.1, 0.92)
border_width_left = 2
border_width_top = 2
border_width_right = 2
border_width_bottom = 2
border_color = Color(0.85, 0.78, 0.5, 0.8)
corner_radius_top_left = 8
corner_radius_top_right = 8
corner_radius_bottom_right = 8
corner_radius_bottom_left = 8

[node name="DialogueBox" type="CanvasLayer"]
layer = 20
visible = false
script = ExtResource("1_dialogue")

[node name="Panel" type="Panel" parent="."]
